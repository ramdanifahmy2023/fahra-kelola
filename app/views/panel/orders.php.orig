<!-- Floating Sync Progress Card (UI Only) -->
<div id="sync-detail-card" class="fixed bottom-6 right-6 z-50 w-80 bg-base-100/80 backdrop-blur-md border border-base-200 shadow-xl rounded-xl p-4 transition-all duration-300 transform translate-y-24 opacity-0 pointer-events-none">
  <div class="flex items-center justify-between mb-3">
    <div class="font-bold text-sm text-base-content flex items-center gap-2">
      <span class="material-symbols-outlined text-[18px] text-primary">cloud_sync</span>
      Proses Sinkronisasi
    </div>
    <div id="sync-detail-badge" class="badge badge-primary badge-sm badge-outline">0%</div>
  </div>
  
  <div class="flex items-center gap-3 mb-3">
    <span class="loading loading-spinner loading-md text-primary" id="sync-detail-spinner"></span>
    <div class="text-xs font-medium text-base-content/80 flex flex-col">
      <span id="sync-detail-text">Menyiapkan antrean...</span>
      <span id="sync-detail-id" class="font-mono text-[11px] opacity-70"></span>
    </div>
  </div>
  
  <progress id="sync-detail-progress" class="progress progress-primary w-full h-1.5" value="0" max="100"></progress>
</div>

<script>
function changeLimit(limit, shopId) {
    window.location.href = '<?= burl; ?>/panel/orders?shop_id=' + shopId + '&limit=' + limit;
}

function selectShop(element, id, name, logo) {
    document.getElementById('selectedShopId').value = id;
    document.getElementById('selectedShopDisplay').innerHTML = `
        <img src="${logo}" class="w-6 h-6 rounded object-cover" />
        <span class="truncate flex-1 text-left">${name}</span>
        <span class="material-symbols-outlined text-[20px] opacity-50 ml-auto">expand_more</span>
    `;
    
    const menu = element.closest('.menu');
    menu.querySelectorAll('a').forEach(a => a.classList.remove('bg-base-200'));
    element.classList.add('bg-base-200');
    document.activeElement.blur();
    
    syncOrders(id);
}

function syncOrders(id, sentinel = '', pageNumber = 1, syncMode = '') {
    const loader = document.getElementById('page-loader');
    if (loader && !sentinel) {
        loader.style.display = 'flex';
        loader.style.opacity = '1';
        loader.querySelector('p').innerText = 'Sedang mengecek database...';
    }

    const formData = new FormData();
    formData.append('shop_id', id);
    formData.append('page_number', pageNumber);
    if (sentinel) {
        formData.append('next_page_sentinel', sentinel);
    }
    if (syncMode) {
        formData.append('sync_mode', syncMode);
    }

    fetch('<?= burl; ?>/procorders/sync_index', {
        method: 'POST',
        headers: {
            'X-Requested-With': 'XMLHttpRequest'
        },
        body: formData
    })
    .then(res => res.json())
    .then(data => {
        if (data.status === 'success') {
            if (data.has_next && data.next_page_sentinel) {
                let currentMode = syncMode || (data.is_empty_mode ? 'full' : 'diff');
                if (!sentinel && loader) {
                    // Ini adalah tarikan pertama, tampilkan status database
                    if (data.is_empty_mode) {
                        loader.querySelector('p').innerText = 'Database kosong...';
                        setTimeout(() => {
                            if (loader) loader.querySelector('p').innerText = 'Penarikan data pertama kali membutuhkan lebih banyak waktu mohon tunggu.. (' + (data.progress_percent || 0) + '%)';
                            setTimeout(() => {
                                syncOrders(id, data.next_page_sentinel, pageNumber + 1, currentMode);
                            }, 1000);
                        }, 1500);
                    } else {
                        loader.querySelector('p').innerText = 'Database ditemukan';
                        setTimeout(() => {
                            if (loader) loader.querySelector('p').innerText = 'Sedang sinkronisasi data pesanan..';
                            setTimeout(() => {
                                syncOrders(id, data.next_page_sentinel, pageNumber + 1, currentMode);
                            }, 1000);
                        }, 1500);
                    }
                } else {
                    // Tarikan selanjutnya (halaman 2 dst), update persentase
                    if (currentMode === 'full' && loader) {
                        loader.querySelector('p').innerText = 'Penarikan data pertama kali membutuhkan lebih banyak waktu mohon tunggu.. (' + (data.progress_percent || 0) + '%)';
                    }
                    setTimeout(() => {
                        syncOrders(id, data.next_page_sentinel, pageNumber + 1, currentMode);
                    }, 1000);
                }
            } else {
                window.location.href = '<?= burl; ?>/panel/orders?shop_id=' + id;
            }
        } else {
            if (loader) {
                loader.style.opacity = '0';
                setTimeout(() => loader.style.display = 'none', 300);
            }
            if (data.debug) {
                alert(data.message + '\n\nDEBUG INFO:\n' + JSON.stringify(data.debug, null, 2));
            } else {
                alert(data.message);
            }
        }
    })
    .catch(err => {
        if (loader) {
            loader.style.opacity = '0';
            setTimeout(() => loader.style.display = 'none', 300);
        }
        alert('Terjadi kesalahan saat menarik data pesanan.');
    });
}

function startDetailSync(shopId) {
    const queueKey = 'sync_queue_' + shopId;
    const totalKey = 'sync_queue_total_' + shopId;
    
    const runQueue = () => {
        let queue = JSON.parse(localStorage.getItem(queueKey) || '[]');
        let total = parseInt(localStorage.getItem(totalKey) || '0');
        
        const card = document.getElementById('sync-detail-card');
        const badge = document.getElementById('sync-detail-badge');
        const progress = document.getElementById('sync-detail-progress');
        const textLabel = document.getElementById('sync-detail-text');
        const textId = document.getElementById('sync-detail-id');
        const spinner = document.getElementById('sync-detail-spinner');
        
        if (queue.length === 0) {
            // Selesai
            if (card && !card.classList.contains('opacity-0')) {
                textLabel.innerText = 'Selesai sinkronisasi!';
                textId.innerText = '';
                spinner.classList.remove('loading-spinner');
                spinner.classList.add('loading-dots');
                
                setTimeout(() => {
                    card.classList.add('translate-y-24', 'opacity-0', 'pointer-events-none');
                }, 3000);
            }
            return;
        }
        
        if (total === 0) {
            total = queue.length;
            localStorage.setItem(totalKey, total);
        }
        
        // Munculkan card jika belum
        card.classList.remove('translate-y-24', 'opacity-0', 'pointer-events-none');
        progress.max = total;
        
        const currentOrderId = queue.shift();
        localStorage.setItem(queueKey, JSON.stringify(queue)); // Simpan sisa queue
        
        let completed = total - queue.length; 
        
        textLabel.innerText = 'Sedang mengambil data';
        textId.innerText = currentOrderId;
        
        const formData = new FormData();
        formData.append('shop_id', shopId);
        formData.append('order_id', currentOrderId);
        
        fetch('<?= burl; ?>/procorders/sync_detail', {
            method: 'POST',
            body: formData
        })
        .then(res => res.json())
        .then(data => {
            if (data.status === 'success' && data.html) {
                // Temukan baris tabel lama jika kebetulan ada di layar
                const oldRow = document.getElementById('order-row-' + currentOrderId);
                if (oldRow) {
                    const temp = document.createElement('table');
                    temp.innerHTML = '<tbody>' + data.html + '</tbody>';
                    const newRow = temp.querySelector('tr');
                    
                    if (newRow) {
                        oldRow.style.opacity = '0.5';
                        setTimeout(() => {
                            oldRow.replaceWith(newRow);
                        }, 150);
                    }
                }
            }
            
            const pct = Math.round((completed / total) * 100);
            badge.innerText = pct + '%';
            progress.value = completed;
            
            setTimeout(runQueue, 200);
        })
        .catch(err => {
            console.error('Error detail sync for ' + currentOrderId, err);
            const pct = Math.round((completed / total) * 100);
            badge.innerText = pct + '%';
            progress.value = completed;
            setTimeout(runQueue, 200);
        });
    };
    
    // Cek local storage
    let existingQueue = JSON.parse(localStorage.getItem(queueKey) || '[]');
    
    if (existingQueue.length === 0) {
        // Tarik antrean dari backend
        const fd = new FormData();
        fd.append('shop_id', shopId);
        fetch('<?= burl; ?>/procorders/get_sync_queue', {
            method: 'POST',
            body: fd
        })
        .then(r => r.json())
        .then(d => {
            if (d.status === 'success' && d.queue && d.queue.length > 0) {
                localStorage.setItem(queueKey, JSON.stringify(d.queue));
                localStorage.setItem(totalKey, d.queue.length.toString());
                runQueue();
            }
        })
        .catch(e => console.error("Gagal mendapatkan antrean sinkronisasi", e));
    } else {
        // Lanjutkan sisa antrean di local storage
        runQueue();
    }
}

document.addEventListener('DOMContentLoaded', () => {
    const activeShopId = '<?= $data['active_shop_id'] ?? '' ?>';
    
    if (activeShopId && !sessionStorage.getItem('synced_orders_' + activeShopId)) {
        sessionStorage.setItem('synced_orders_' + activeShopId, '1');
        syncOrders(activeShopId);
    } else {
        const loader = document.getElementById('page-loader');
        if (loader) {
            loader.style.opacity = '0';
            setTimeout(() => {
                loader.style.display = 'none';
                
                // Setelah loading menghilang, jalankan background sync detail
                if (activeShopId) {
                    startDetailSync(activeShopId);
                }
            }, 300);
        }
    }
});
</script>
