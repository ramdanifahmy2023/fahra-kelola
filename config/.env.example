# Application Info
APP_NAME="SHOPDASH"
APP_URL="http://127.0.0.1:8123"
# Optional comma-separated exact host allowlist; defaults to APP_URL host.
APP_ALLOWED_HOSTS="127.0.0.1"
# Set only when a trusted reverse proxy terminates TLS and forwards X-Forwarded-Proto.
APP_TRUST_PROXY="0"
APP_FORCE_HTTPS="0"

# Routing Configuration
DEFAULT_CONTROLLER="Home"

# Database Configuration
DB_HOST="127.0.0.1"
DB_PORT="3306"
DB_USER="root"
DB_PASS=""
DB_NAME="shopdash_db"

# Legacy provider settings: informational only, no automatic fallback
NINE_ROUTER_BASE_URL=""
NINE_ROUTER_API_KEY=""
NINE_ROUTER_MODEL=""

# Optional absolute keyring path; default storage/ai-connection-keys.json
# Initialize once using php bin/ai-connection-key.php --init. Never commit the keyring.
AI_CONNECTION_KEY_FILE=""
# Comma-separated exact origins for a local/LAN 9Router, e.g. http://127.0.0.1:20128
AI_CONNECTION_ALLOWED_ORIGINS=""
